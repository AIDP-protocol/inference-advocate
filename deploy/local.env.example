# Host-local deploy settings. Copy to deploy/local.env and fill in real values.
# deploy/local.env is gitignored: never commit machine paths or personal emails.
#
# AIRP_REPO_ROOT is always the repository checkout (detected by the script).
# Do not put it here.

# Parent directory for Apache DocumentRoots (one leaf subdirectory per hostname).
AIRP_SITES_ROOT=/var/www/sites

# Regex alternation of directory roots that must never be DocumentRoot/Alias targets.
# Include AIRP_SITES_ROOT. If that path is a symlink into a home directory, also
# include the real home path so a mis-aimed root cannot expose it.
# Quote the value: the pipe is shell syntax otherwise.
# Example: AIRP_DENY_ROOTS='/var/www/sites|/home/deploy'
AIRP_DENY_ROOTS='/var/www/sites|/home/deploy'

# Used as Apache ServerAdmin and for Let's Encrypt registration.
AIRP_SERVER_ADMIN=ops@example.com
CERTBOT_EMAIL=ops@example.com

# Optional tool overrides when they are not on PATH.
# NODE_BIN=/usr/bin/node
# NPM_BIN=/usr/bin/npm
# PM2_BIN=/usr/bin/pm2
