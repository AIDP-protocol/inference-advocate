{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inference Advocate",
  "version": "0.1.0",
  "identifier": "org.aidp.advocate",
  "build": {
    "beforeDevCommand": "node scripts/ensure-built.mjs",
    "devUrl": "../../ui/dist",
    "beforeBuildCommand": "node scripts/ensure-built.mjs",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Inference Advocate",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
